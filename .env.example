# ══════════════════════════════════════════════════════════════════════════════
#  .env.example — Voice Pipeline environment template
#
#  Copy this file to .env and fill in all required values before running.
#  Never commit .env to version control — only commit this example file.
#
#  cp .env.example .env
# ══════════════════════════════════════════════════════════════════════════════

# Voice Pipeline — Environment Configuration
# In production, inject these via Docker secrets, K8s Secrets, or your cloud provider's secret manager.

# LOG MODE: standard | verbose
LOG_MODE=standard

# ==============================================================================
# REQUIRED — the service will not start without these
# ==============================================================================
APP_MODE=desktop
# RUN - python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=                    # python -c "import secrets; print(secrets.token_hex(32))"
SESSION_TTL_S=1800
SESSION_GRACE_S=300
SESSION_MAX_IP_CHANGES=3

# OpenAI API key. Must start with sk-
# Obtain from https://platform.openai.com/api-keys
OPENAI_API_KEY=                         # sk-...

# ==============================================================================
# DOCKER STACK CREDENTIALS
# Required by docker-compose.yaml — set strong values before first `docker compose up`
# ==============================================================================

# Grafana admin UI password (http://localhost:3000, user: admin)
GRAFANA_PASSWORD=                       # set a strong password
GRAFANA_OUT_DIR=infra/grafana

# Redis auth password — injected via --requirepass at container startup.
# Must match REDIS_URL below. Use: python -c "import secrets; print(secrets.token_hex(24))"
REDIS_PASSWORD=                         # python -c "import secrets; print(secrets.token_hex(24))"

# MongoDB admin credentials — used by the observability event sink (vp_mongo).
# Use: python -c "import secrets; print(secrets.token_hex(24))" for MONGO_PASSWORD
MONGO_USERNAME=admin
MONGO_PASSWORD=                         # python -c "import secrets; print(secrets.token_hex(24))"
MONGO_URL="mongodb://admin:<MONGO_PASSWORD>@mongo:27017"

# NOTE: metrics are now served as an ASGI route at GET /metrics on PORT=8000
# (main.py calls bootstrap(start_prometheus=False)). No separate metrics server
# binds this port. PROMETHEUS_PORT is unused — Prometheus scrapes app:8000/metrics.
# Kept here so settings.py validation doesn't fail if it reads this key.
PROMETHEUS_PORT=9091

# ==============================================================================
# LLM NODE
# ==============================================================================

# Primary chat model. Used for all normal requests.
# Options: gpt-5.2, gpt-5-mini, gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-4, gpt-3.5-turbo
LLM_MODEL=gpt-5-mini

# Fallback model. Must differ from LLM_MODEL.
# Activated automatically when the primary model's circuit breaker opens.
LLM_FALLBACK_MODEL=gpt-5-nano

# Sampling temperature. 0.0 = deterministic, 2.0 = most random.
# 0.7 is a good balance for conversational voice assistants.
LLM_TEMPERATURE=0.7

# Max simultaneous LLM requests in flight across all workers.
# Keep this below your OpenAI tier's RPM limit divided by expected request duration.
LLM_MAX_CONCURRENT=50

# Token-bucket rate limiter: sustained throughput per second.
LLM_RATE_PER_SEC=20.0

# Token-bucket rate limiter: burst headroom (must be >= LLM_RATE_PER_SEC).
# Think of this as how many requests can hit simultaneously before throttling kicks in.
LLM_RATE_BURST=40.0

# How long to keep a cached LLM response in Redis, in seconds.
# 0 = cache forever (not recommended in production — stale responses accumulate).
# 3600 = 1 hour is a sensible default for most voice assistants.
LLM_CACHE_TTL=3600

# ==============================================================================
# REDIS (LLM cache + stampede locks)
# ==============================================================================

# Redis is enabled and wired to the vp_redis Docker container.
# Set to false to run without Redis (LLM responses won't be cached and stampede
# locks are disabled). Useful for local dev or environments without a Redis server.
REDIS_ENABLED=true

# Redis connection URL pointing at the vp_redis Docker container.
# NOTE: ${VAR} interpolation does NOT work inside an env_file — Docker reads
# this file literally. The correct URL is injected by the `environment:` block
# in docker-compose.yaml, which overrides this value. Keep this in sync manually
# if you change REDIS_PASSWORD.
# If running the app on the host (outside Docker): use localhost:6379.
# If running the app inside a Docker container on the same compose network: use redis:6379.
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379

# Max Redis connections in the pool.
# Must be >= LLM_MAX_CONCURRENT or the pool will be exhausted under load.
# Rule of thumb: set this to LLM_MAX_CONCURRENT + 20% headroom.
REDIS_MAX_CONN=200

# Gunicorn support for concurrency
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=150

# ==============================================================================
# STT NODE (OpenAI Whisper)
# ==============================================================================

# Whisper model to use. Currently only whisper-1 is available via the API.
STT_MODEL=whisper-1

# Max audio file size accepted by the STT node, in MB.
# Cannot exceed 25 — that is the Whisper API's hard ceiling.
# This should match or be lower than MAX_UPLOAD_MB in the gateway section.
STT_MAX_FILE_MB=25.0

# Max simultaneous Whisper transcription jobs.
# Whisper calls are slow and expensive; keep this conservative.
STT_MAX_CONCURRENT=20

# STT rate limiter — sustained requests per second.
STT_RATE_PER_SEC=10.0

# STT rate limiter — burst capacity (must be >= STT_RATE_PER_SEC).
STT_RATE_BURST=20.0

# S3 bucket to read audio from and write transcripts to.
# Leave empty to use local disk only.
STT_S3_BUCKET=

# S3 key prefix for stored transcripts.
# A trailing slash is added automatically if missing.
STT_S3_TRANSCRIPT_PREFIX=transcripts/

# ==============================================================================
# TTS NODE (OpenAI TTS)
# ==============================================================================

# TTS model. tts-1-hd sounds noticeably better; tts-1 is faster and cheaper.
# Options: tts-1, tts-1-hd
TTS_MODEL=tts-1

# Voice character.
# Options: alloy, echo, fable, onyx, nova, shimmer
TTS_VOICE=nova

# Audio output format. mp3 is the smallest with the widest client support.
# Options: mp3, opus, aac, flac, wav, pcm
TTS_FORMAT=mp3

# Local directory where generated audio files are written before S3 upload.
# Created automatically if it doesn't exist.
TTS_OUTPUT_DIR=audio/temp_OUT

# Max simultaneous TTS synthesis jobs.
TTS_MAX_CONCURRENT=20

# TTS rate limiter — sustained requests per second.
TTS_RATE_PER_SEC=10.0

# TTS rate limiter — burst capacity (must be >= TTS_RATE_PER_SEC).
TTS_RATE_BURST=20.0

# How long local TTS audio files are kept before the background cleanup task deletes them.
# In seconds. 3600 = 1 hour. 0 = never delete (not recommended — disk fills up).
# If TTS_S3_BUCKET is set, local files are just temporary working copies and can be short-lived.
TTS_LOCAL_FILE_TTL=3600

# S3 bucket to upload finished audio files to.
# Leave empty to serve audio from local disk only.
TTS_S3_BUCKET=

# S3 key prefix for stored audio files.
TTS_S3_PREFIX=tts/

# ==============================================================================
# AWS (shared by STT and TTS S3 integration)
# ==============================================================================

# AWS region where your S3 buckets live.
# Only required if STT_S3_BUCKET or TTS_S3_BUCKET are set.
AWS_REGION=us-east-1

# AWS credentials.
# In production on EC2/ECS/EKS, leave these blank and use an IAM instance role instead —
# that is more secure than baking credentials into environment variables.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ==============================================================================
# GRAPH / ORCHESTRATION
# ==============================================================================

# Pipeline version label — appears in every log line and Prometheus metric.
# Increment when you make breaking changes to the pipeline so you can slice
# dashboards by version during rollouts.
VOICE_GRAPH_VERSION=v1

# Per-stage timeouts in seconds. If a stage exceeds its timeout the pipeline
# degrades gracefully: STT failure passes an apology prompt to LLM,
# LLM failure fills in an apology string, TTS failure returns text-only.
GRAPH_STT_TIMEOUT=30.0
GRAPH_LLM_TIMEOUT=45.0
GRAPH_TTS_TIMEOUT=30.0

# Max characters kept from the Whisper transcript before passing to LLM.
# Prevents pathologically long audio from producing huge prompts.
GRAPH_MAX_TRANSCRIPT_CHARS=2000

# Max characters kept from the LLM response before passing to the sanitize node.
GRAPH_MAX_LLM_RESPONSE_CHARS=4096

# Max characters passed to TTS per full request (across all chunks).
# Cannot exceed 4096 — that is the OpenAI TTS per-request ceiling.
# Must be <= GRAPH_MAX_LLM_RESPONSE_CHARS or this cap is never reached.
GRAPH_MAX_TTS_CHARS=4000

# Max audio duration the STT node will accept, in seconds.
# Files longer than this are rejected before the API call.
GRAPH_MAX_AUDIO_DURATION_S=300.0

# Minimum transcript length (characters) before the LLM is fired in stream_full().
# Prevents sending filler words ("uh", "so") to the LLM before the user has
# expressed enough intent to generate a useful response.
GRAPH_MIN_PROMPT_CHARS=25

# Maximum simultaneous in-flight requests admitted to the standard voice_graph singleton.
# Requests beyond this cap are load-shed immediately rather than queued.
GRAPH_MAX_INFLIGHT=20

# Per-call inter-stage queue depths for stream_full(). Each request gets its own queues.
# A deeper queue absorbs short bursts from a fast upstream stage but uses more memory.
# LLM→TTS should be >= STT→LLM because TTS is typically slower than LLM.
GRAPH_STT_LLM_QUEUE_DEPTH=8
GRAPH_LLM_TTS_QUEUE_DEPTH=16

# ==============================================================================
# FASTAPI GATEWAY
# ==============================================================================

# Local directory where uploaded audio files are saved before pipeline processing.
# Cleaned up after each request regardless of outcome.
AUDIO_INPUT_DIR=audio/temp_IN

# Max audio upload size at the API layer, in MB.
# Must be <= STT_MAX_FILE_MB or uploads will be accepted then rejected inside the node.
MAX_UPLOAD_MB=25.0

# Total wall-clock timeout for a full STT → LLM → TTS pipeline run, in seconds.
# Must be greater than GRAPH_STT_TIMEOUT + GRAPH_LLM_TIMEOUT + GRAPH_TTS_TIMEOUT.
# Currently that sum is 105s — set this meaningfully above that.
PIPELINE_TIMEOUT=120.0

# Timeout for the streaming WebSocket path, in seconds.
STREAM_TIMEOUT=90.0

# Comma-separated list of allowed CORS origins.
# Use * only during local development.
# Production example: https://yourapp.com,https://admin.yourapp.com
CORS_ORIGINS=*

# Interface the server binds to.
# 0.0.0.0 is correct for containers — it accepts connections on all interfaces.
# Do not set this to localhost or 127.0.0.1 in a container; the service won't be reachable.
HOST=0.0.0.0

# Port the server listens on.
PORT=8000

# Runtime environment. Controls hot-reload and some warning behaviour.
# Options: production, development, test
ENV=development

# ==============================================================================
# CONTROLLER (desktop push-to-talk)
# ==============================================================================

# Key to hold while speaking. Any keyboard library key name (e.g. h, space, f1).
CONTROLLER_PTT_KEY=h

# Key to press for a clean exit.
CONTROLLER_EXIT_KEY=esc

# How often the keyboard poll loop checks for key state (seconds, ~33 Hz default).
# Lower = more responsive but higher CPU usage on the polling thread.
CONTROLLER_POLL_INTERVAL_S=0.03

# How long to wait after a PTT key release before allowing the next press.
# Prevents accidental double-triggers from key bounce.
CONTROLLER_DEBOUNCE_S=0.35

# Delay between sending a cancel signal and clearing the interrupt flag,
# giving the event loop time to process the cancellation (seconds).
CONTROLLER_INTERRUPT_DRAIN_S=0.05

# Sleep before calling loop.stop() on shutdown, giving in-flight coroutines
# a window to notice the cancellation (seconds).
CONTROLLER_LOOP_DRAIN_S=0.10

# How long to wait for the event loop thread to exit after loop.stop() (seconds).
CONTROLLER_LOOP_JOIN_TIMEOUT=3.0

# ==============================================================================
# OPENTELEMETRY
# ==============================================================================

# OTLP collector endpoint for traces and metrics.
# The app runs INSIDE Docker on the same `observability` network as vp_otel,
# so it reaches the collector by service name. The grpc exporter in shared.py
# and observability.py uses port 4319 (gRPC OTLP receiver).
# vp_otel exposes:
#   4318 → HTTP OTLP receiver
#   4319 → gRPC OTLP receiver   ← correct for the grpc exporter
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel:4319

# Matches the service.name resource attribute set in otel-collector-config.yaml
# and the service label used by Promtail / Loki derivedFields in datasources.yaml.
OTEL_SERVICE_NAME=voice-pipeline

# OpenTelemetry tracing and metrics export is enabled.
# Requires the full observability stack (docker compose up -d) to be running.
# Set to false to disable if the collector is not available.
OTEL_ENABLED=true

# Let observability.bootstrap() own TracerProvider + MeterProvider installation.
# Without this, shared.py installs providers at import time and bootstrap()'s
# second install is silently rejected ("Overriding of current TracerProvider is
# not allowed"), meaning the real OTLP endpoint config is never applied.
OBSERVABILITY_OWNS_OTEL=true

# How often the OTel SDK pushes metrics to the collector (milliseconds).
# Default is 30000 (30 s) which is why metrics appear ~30 s after the first
# request. 5000 makes panels update much faster during development.
OTEL_METRIC_INTERVAL_MS=5000

# ==============================================================================
# GRAFANA DATASOURCE URLS
# ==============================================================================
# These are read by write_grafana_dashboard() in observability.py when it
# writes the provisioning YAML files at startup. Both the app and Grafana run
# inside Docker and share the `observability` network, so all URLs use Docker
# service names — not localhost.

# Tempo trace backend — queried by Grafana for trace search and span display.
TEMPO_URL=http://tempo:3200

# Loki log backend — queried by Grafana for log panels and log-to-trace links.
LOKI_URL=http://loki:3100

# Prometheus metrics backend — queried by Grafana for all metric panels.
PROMETHEUS_URL=http://prometheus:9090

# ==============================================================================
# OBSERVABILITY STACK — SERVICE ENDPOINTS (for reference / health checks)
# ==============================================================================
# These are not read by the app directly but document where each service lives.
#
#   Grafana UI:        http://localhost:3000    (admin / GRAFANA_PASSWORD)
#   Prometheus UI:     http://localhost:9090
#   Tempo UI:          http://localhost:3200
#   Loki:              http://localhost:3100
#   OTel HTTP ingest:  http://localhost:4318
#   OTel gRPC ingest:  http://localhost:4319    ← OTEL_EXPORTER_OTLP_ENDPOINT
#   Redis:             localhost:6379           ← REDIS_URL
#   MongoDB:           localhost:27017
#   Redis Exporter:    http://localhost:9121/metrics
#   Node Exporter:     http://localhost:9100/metrics
#   cAdvisor:          http://localhost:8080/metrics
#   App API + /metrics:  http://localhost:8000   (API on /, metrics at /metrics)